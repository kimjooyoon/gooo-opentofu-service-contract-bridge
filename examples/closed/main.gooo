schema "gooo/opentofu-service-contract-bridge/v1"
project "closed-shop-api"

infrastructure_claim id="closed-infra-checkout" service="shop" resource_type="gooo_service" resource_name="checkout" scope="prod" capability="http"
infrastructure_claim id="closed-infra-catalog" service="shop" resource_type="gooo_service" resource_name="catalog" scope="prod" capability="http"
infrastructure_claim id="closed-infra-billing" service="shop" resource_type="gooo_service" resource_name="billing" scope="prod" capability="http"
infrastructure_claim id="closed-infra-search" service="shop" resource_type="gooo_service" resource_name="search" scope="prod" capability="http"

service_contract_claim id="closed-contract-checkout" service="shop" contract="openapi" operation_id="checkout" method="GET" path="/checkout" contract_type="http" name="checkout" scope="prod"
service_contract_claim id="closed-contract-catalog" service="shop" contract="openapi" operation_id="catalog" method="GET" path="/catalog" contract_type="http" name="catalog" scope="prod"
service_contract_claim id="closed-contract-billing" service="shop" contract="openapi" operation_id="billing" method="GET" path="/billing" contract_type="http" name="billing" scope="prod"
service_contract_claim id="closed-contract-search" service="shop" contract="openapi" operation_id="search" method="GET" path="/search" contract_type="http" name="search" scope="prod"

mapping_rule id="closed-map-checkout" infrastructure_claim="closed-infra-checkout" service_contract_claim="closed-contract-checkout" match="type,name,scope"
mapping_rule id="closed-map-catalog" infrastructure_claim="closed-infra-catalog" service_contract_claim="closed-contract-catalog" match="type,name,scope"
mapping_rule id="closed-map-billing" infrastructure_claim="closed-infra-billing" service_contract_claim="closed-contract-billing" match="type,name,scope"
mapping_rule id="closed-map-search" infrastructure_claim="closed-infra-search" service_contract_claim="closed-contract-search" match="type,name,scope"

evidence_binding id="closed-evidence-checkout" mapping_rule="closed-map-checkout" infrastructure_locator="resource.gooo_service.checkout" contract_locator="path.GET./checkout" evidence="OBSERVED_INPUT"
evidence_binding id="closed-evidence-catalog" mapping_rule="closed-map-catalog" infrastructure_locator="resource.gooo_service.catalog" contract_locator="path.GET./catalog" evidence="OBSERVED_INPUT"
evidence_binding id="closed-evidence-billing" mapping_rule="closed-map-billing" infrastructure_locator="resource.gooo_service.billing" contract_locator="path.GET./billing" evidence="OBSERVED_INPUT"
evidence_binding id="closed-evidence-search" mapping_rule="closed-map-search" infrastructure_locator="resource.gooo_service.search" contract_locator="path.GET./search" evidence="OBSERVED_INPUT"

drift_decision id="closed-decision-checkout" mapping_rule="closed-map-checkout" expected="CLOSED" precedence="REFUTED>UNKNOWN>CLOSED"
drift_decision id="closed-decision-catalog" mapping_rule="closed-map-catalog" expected="CLOSED" precedence="REFUTED>UNKNOWN>CLOSED"
drift_decision id="closed-decision-billing" mapping_rule="closed-map-billing" expected="CLOSED" precedence="REFUTED>UNKNOWN>CLOSED"
drift_decision id="closed-decision-search" mapping_rule="closed-map-search" expected="CLOSED" precedence="REFUTED>UNKNOWN>CLOSED"

case id="closed-case-checkout" mapping_rule="closed-map-checkout" expected="CLOSED"
case id="closed-case-catalog" mapping_rule="closed-map-catalog" expected="CLOSED"
case id="closed-case-billing" mapping_rule="closed-map-billing" expected="CLOSED"
case id="closed-case-search" mapping_rule="closed-map-search" expected="CLOSED"

meta_activity ordinal=1 id="closed-activity-01" name="ReadGoooAuthority" proof="FOUNDATION" indicator="DRIVER" input=".gooo" output="claims"
meta_activity ordinal=2 id="closed-activity-02" name="ReadBoundedOpenTofu" proof="FOUNDATION" indicator="DRIVER" input="main.tf" output="resources"
meta_activity ordinal=3 id="closed-activity-03" name="ReadBoundedOpenAPI" proof="FOUNDATION" indicator="DRIVER" input="openapi.yaml" output="operations"
meta_activity ordinal=4 id="closed-activity-04" name="InventorySources" proof="FOUNDATION" indicator="DRIVER" input="source-files" output="line-counts"
meta_activity ordinal=5 id="closed-activity-05" name="ProjectClaims" proof="COHERENCE" indicator="OUTCOME" input="claims" output="projection"
meta_activity ordinal=6 id="closed-activity-06" name="BindEvidence" proof="COHERENCE" indicator="OUTCOME" input="projection" output="bindings"
meta_activity ordinal=7 id="closed-activity-07" name="EvaluateMappings" proof="COHERENCE" indicator="OUTCOME" input="bindings" output="comparisons"
meta_activity ordinal=8 id="closed-activity-08" name="ClassifyDecision" proof="COHERENCE" indicator="OUTCOME" input="comparisons" output="decisions"
meta_activity ordinal=9 id="closed-activity-09" name="PreserveUnknown" proof="REGRESSION" indicator="GUARDRAIL" input="decisions" output="unknown-fields"
meta_activity ordinal=10 id="closed-activity-10" name="RenderHumanDossier" proof="REGRESSION" indicator="GUARDRAIL" input="decisions" output="dossier.md"
meta_activity ordinal=11 id="closed-activity-11" name="RenderMachineManifest" proof="REGRESSION" indicator="GUARDRAIL" input="projection" output="manifest.json"
meta_activity ordinal=12 id="closed-activity-12" name="AuditOutputBoundary" proof="REGRESSION" indicator="GUARDRAIL" input="output" output="boundary-receipt"
