schema "gooo/opentofu-service-contract-bridge/v1"
project "unknown-shop-api"

infrastructure_claim id="unknown-infra-missing" service="shop" resource_type="gooo_service" resource_name="missing" scope="prod" capability="http"
infrastructure_claim id="unknown-infra-operation" service="shop" resource_type="gooo_service" resource_name="orders" scope="prod" capability="http"
infrastructure_claim id="unknown-infra-scope" service="shop" resource_type="gooo_service" resource_name="profile" scope="prod" capability="http"
infrastructure_claim id="unknown-infra-operation-id" service="shop" resource_type="gooo_service" resource_name="reports" scope="prod" capability="http"

service_contract_claim id="unknown-contract-missing" service="shop" contract="openapi" operation_id="missing" method="GET" path="/missing" contract_type="http" name="missing" scope="prod"
service_contract_claim id="unknown-contract-operation" service="shop" contract="openapi" operation_id="orders" method="GET" path="/orders" contract_type="http" name="orders" scope="prod"
service_contract_claim id="unknown-contract-scope" service="shop" contract="openapi" operation_id="profile" method="GET" path="/profile" contract_type="http" name="profile" scope="prod"
service_contract_claim id="unknown-contract-operation-id" service="shop" contract="openapi" operation_id="reports" method="GET" path="/reports" contract_type="http" name="reports" scope="prod"

mapping_rule id="unknown-map-missing" infrastructure_claim="unknown-infra-missing" service_contract_claim="unknown-contract-missing" match="type,name,scope"
mapping_rule id="unknown-map-operation" infrastructure_claim="unknown-infra-operation" service_contract_claim="unknown-contract-operation" match="type,name,scope"
mapping_rule id="unknown-map-scope" infrastructure_claim="unknown-infra-scope" service_contract_claim="unknown-contract-scope" match="type,name,scope"
mapping_rule id="unknown-map-operation-id" infrastructure_claim="unknown-infra-operation-id" service_contract_claim="unknown-contract-operation-id" match="type,name,scope"

evidence_binding id="unknown-evidence-missing" mapping_rule="unknown-map-missing" infrastructure_locator="resource.gooo_service.missing" contract_locator="path.GET./missing" evidence="OBSERVED_INPUT"
evidence_binding id="unknown-evidence-operation" mapping_rule="unknown-map-operation" infrastructure_locator="resource.gooo_service.orders" contract_locator="path.GET./missing-orders" evidence="OBSERVED_INPUT"
evidence_binding id="unknown-evidence-scope" mapping_rule="unknown-map-scope" infrastructure_locator="resource.gooo_service.profile" contract_locator="path.GET./profile" evidence="OBSERVED_INPUT"
evidence_binding id="unknown-evidence-operation-id" mapping_rule="unknown-map-operation-id" infrastructure_locator="resource.gooo_service.reports" contract_locator="path.GET./reports" evidence="OBSERVED_INPUT"

drift_decision id="unknown-decision-missing" mapping_rule="unknown-map-missing" expected="UNKNOWN" precedence="REFUTED>UNKNOWN>CLOSED" unknown_stage="project" unknown_step="bind-evidence" unknown_reason="resource locator is absent from bounded OpenTofu input" unknown_class="MISSING_RESOURCE" next_operation="inspect the read-only OpenTofu source" blocked_by=""
drift_decision id="unknown-decision-operation" mapping_rule="unknown-map-operation" expected="UNKNOWN" precedence="REFUTED>UNKNOWN>CLOSED" unknown_stage="project" unknown_step="bind-evidence" unknown_reason="contract locator is absent from bounded OpenAPI input" unknown_class="MISSING_OPERATION" next_operation="inspect the read-only OpenAPI document" blocked_by=""
drift_decision id="unknown-decision-scope" mapping_rule="unknown-map-scope" expected="UNKNOWN" precedence="REFUTED>UNKNOWN>CLOSED" unknown_stage="project" unknown_step="project-claims" unknown_reason="required scope argument is absent from the observed resource" unknown_class="MISSING_ATTRIBUTE" next_operation="add or observe a literal scope argument" blocked_by="resource.gooo_service.profile"
drift_decision id="unknown-decision-operation-id" mapping_rule="unknown-map-operation-id" expected="UNKNOWN" precedence="REFUTED>UNKNOWN>CLOSED" unknown_stage="project" unknown_step="project-claims" unknown_reason="OpenAPI operationId is optional and absent from the observed operation" unknown_class="MISSING_OPERATION_ID" next_operation="observe an operationId for the operation" blocked_by="path.GET./reports"

case id="unknown-case-missing" mapping_rule="unknown-map-missing" expected="UNKNOWN"
case id="unknown-case-operation" mapping_rule="unknown-map-operation" expected="UNKNOWN"
case id="unknown-case-scope" mapping_rule="unknown-map-scope" expected="UNKNOWN"
case id="unknown-case-operation-id" mapping_rule="unknown-map-operation-id" expected="UNKNOWN"

meta_activity ordinal=1 id="unknown-activity-01" name="ReadGoooAuthority" proof="FOUNDATION" indicator="DRIVER" input=".gooo" output="claims"
meta_activity ordinal=2 id="unknown-activity-02" name="ReadBoundedOpenTofu" proof="FOUNDATION" indicator="DRIVER" input="main.tf" output="resources"
meta_activity ordinal=3 id="unknown-activity-03" name="ReadBoundedOpenAPI" proof="FOUNDATION" indicator="DRIVER" input="openapi.yaml" output="operations"
meta_activity ordinal=4 id="unknown-activity-04" name="InventorySources" proof="FOUNDATION" indicator="DRIVER" input="source-files" output="line-counts"
meta_activity ordinal=5 id="unknown-activity-05" name="ProjectClaims" proof="COHERENCE" indicator="OUTCOME" input="claims" output="projection"
meta_activity ordinal=6 id="unknown-activity-06" name="BindEvidence" proof="COHERENCE" indicator="OUTCOME" input="projection" output="bindings"
meta_activity ordinal=7 id="unknown-activity-07" name="EvaluateMappings" proof="COHERENCE" indicator="OUTCOME" input="bindings" output="comparisons"
meta_activity ordinal=8 id="unknown-activity-08" name="ClassifyDecision" proof="COHERENCE" indicator="OUTCOME" input="comparisons" output="decisions"
meta_activity ordinal=9 id="unknown-activity-09" name="PreserveUnknown" proof="REGRESSION" indicator="GUARDRAIL" input="decisions" output="unknown-fields"
meta_activity ordinal=10 id="unknown-activity-10" name="RenderHumanDossier" proof="REGRESSION" indicator="GUARDRAIL" input="decisions" output="dossier.md"
meta_activity ordinal=11 id="unknown-activity-11" name="RenderMachineManifest" proof="REGRESSION" indicator="GUARDRAIL" input="projection" output="manifest.json"
meta_activity ordinal=12 id="unknown-activity-12" name="AuditOutputBoundary" proof="REGRESSION" indicator="GUARDRAIL" input="output" output="boundary-receipt"
