schema "gooo/opentofu-service-contract-bridge/v1"
project "refuted-shop-api"

infrastructure_claim id="refuted-infra-type" service="shop" resource_type="gooo_service" resource_name="events" scope="prod" capability="queue"
infrastructure_claim id="refuted-infra-name" service="shop" resource_type="gooo_service" resource_name="payments" scope="prod" capability="http"
infrastructure_claim id="refuted-infra-scope" service="shop" resource_type="gooo_service" resource_name="admin" scope="prod" capability="http"
infrastructure_claim id="refuted-infra-method" service="shop" resource_type="gooo_service" resource_name="events-post" scope="prod" capability="http"

service_contract_claim id="refuted-contract-type" service="shop" contract="openapi" operation_id="events" method="GET" path="/events" contract_type="http" name="events" scope="prod"
service_contract_claim id="refuted-contract-name" service="shop" contract="openapi" operation_id="checkout" method="GET" path="/checkout" contract_type="http" name="checkout" scope="prod"
service_contract_claim id="refuted-contract-scope" service="shop" contract="openapi" operation_id="admin" method="GET" path="/admin" contract_type="http" name="admin" scope="staging"
service_contract_claim id="refuted-contract-method" service="shop" contract="openapi" operation_id="events-post" method="POST" path="/events-post" contract_type="http" name="events-post" scope="prod"

mapping_rule id="refuted-map-type" infrastructure_claim="refuted-infra-type" service_contract_claim="refuted-contract-type" match="type,name,scope"
mapping_rule id="refuted-map-name" infrastructure_claim="refuted-infra-name" service_contract_claim="refuted-contract-name" match="type,name,scope"
mapping_rule id="refuted-map-scope" infrastructure_claim="refuted-infra-scope" service_contract_claim="refuted-contract-scope" match="type,name,scope"
mapping_rule id="refuted-map-method" infrastructure_claim="refuted-infra-method" service_contract_claim="refuted-contract-method" match="type,name,scope,method"

evidence_binding id="refuted-evidence-type" mapping_rule="refuted-map-type" infrastructure_locator="resource.gooo_service.events" contract_locator="path.GET./events" evidence="OBSERVED_INPUT"
evidence_binding id="refuted-evidence-name" mapping_rule="refuted-map-name" infrastructure_locator="resource.gooo_service.payments" contract_locator="path.GET./checkout" evidence="OBSERVED_INPUT"
evidence_binding id="refuted-evidence-scope" mapping_rule="refuted-map-scope" infrastructure_locator="resource.gooo_service.admin" contract_locator="path.GET./admin" evidence="OBSERVED_INPUT"
evidence_binding id="refuted-evidence-method" mapping_rule="refuted-map-method" infrastructure_locator="resource.gooo_service.events-post" contract_locator="path.GET./events-post" evidence="OBSERVED_INPUT"

drift_decision id="refuted-decision-type" mapping_rule="refuted-map-type" expected="REFUTED" precedence="REFUTED>UNKNOWN>CLOSED"
drift_decision id="refuted-decision-name" mapping_rule="refuted-map-name" expected="REFUTED" precedence="REFUTED>UNKNOWN>CLOSED"
drift_decision id="refuted-decision-scope" mapping_rule="refuted-map-scope" expected="REFUTED" precedence="REFUTED>UNKNOWN>CLOSED"
drift_decision id="refuted-decision-method" mapping_rule="refuted-map-method" expected="REFUTED" precedence="REFUTED>UNKNOWN>CLOSED"

case id="refuted-case-type" mapping_rule="refuted-map-type" expected="REFUTED"
case id="refuted-case-name" mapping_rule="refuted-map-name" expected="REFUTED"
case id="refuted-case-scope" mapping_rule="refuted-map-scope" expected="REFUTED"
case id="refuted-case-method" mapping_rule="refuted-map-method" expected="REFUTED"

meta_activity ordinal=1 id="refuted-activity-01" name="ReadGoooAuthority" proof="FOUNDATION" indicator="DRIVER" input=".gooo" output="claims"
meta_activity ordinal=2 id="refuted-activity-02" name="ReadBoundedOpenTofu" proof="FOUNDATION" indicator="DRIVER" input="main.tf" output="resources"
meta_activity ordinal=3 id="refuted-activity-03" name="ReadBoundedOpenAPI" proof="FOUNDATION" indicator="DRIVER" input="openapi.yaml" output="operations"
meta_activity ordinal=4 id="refuted-activity-04" name="InventorySources" proof="FOUNDATION" indicator="DRIVER" input="source-files" output="line-counts"
meta_activity ordinal=5 id="refuted-activity-05" name="ProjectClaims" proof="COHERENCE" indicator="OUTCOME" input="claims" output="projection"
meta_activity ordinal=6 id="refuted-activity-06" name="BindEvidence" proof="COHERENCE" indicator="OUTCOME" input="projection" output="bindings"
meta_activity ordinal=7 id="refuted-activity-07" name="EvaluateMappings" proof="COHERENCE" indicator="OUTCOME" input="bindings" output="comparisons"
meta_activity ordinal=8 id="refuted-activity-08" name="ClassifyDecision" proof="COHERENCE" indicator="OUTCOME" input="comparisons" output="decisions"
meta_activity ordinal=9 id="refuted-activity-09" name="PreserveUnknown" proof="REGRESSION" indicator="GUARDRAIL" input="decisions" output="unknown-fields"
meta_activity ordinal=10 id="refuted-activity-10" name="RenderHumanDossier" proof="REGRESSION" indicator="GUARDRAIL" input="decisions" output="dossier.md"
meta_activity ordinal=11 id="refuted-activity-11" name="RenderMachineManifest" proof="REGRESSION" indicator="GUARDRAIL" input="projection" output="manifest.json"
meta_activity ordinal=12 id="refuted-activity-12" name="AuditOutputBoundary" proof="REGRESSION" indicator="GUARDRAIL" input="output" output="boundary-receipt"
